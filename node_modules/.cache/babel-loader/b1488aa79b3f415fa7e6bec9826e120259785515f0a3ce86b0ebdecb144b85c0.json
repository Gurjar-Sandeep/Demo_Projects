{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { XMLParser } from \"fast-xml-parser\";\nexport default {\n  data() {\n    return {\n      rawHeaders: [{\n        title: \"Title\",\n        key: \"title\",\n        sortable: true\n      }, {\n        title: \"Author\",\n        key: \"author\",\n        sortable: true\n      }],\n      documents: [],\n      loading: true,\n      search: \"\",\n      sortBy: [{\n        key: \"title\",\n        order: \"asc\"\n      }],\n      // Default sorting\n      itemsPerPage: 10\n    };\n  },\n  computed: {\n    computedHeaders() {\n      return this.rawHeaders;\n    },\n    filteredDocuments() {\n      return this.documents.filter(doc => doc.title.toLowerCase().includes(this.search.toLowerCase()) || doc.author.toLowerCase().includes(this.search.toLowerCase())).sort((a, b) => this.sortFunction(a, b));\n    }\n  },\n  mounted() {\n    this.fetchDocuments();\n  },\n  methods: {\n    async fetchDocuments() {\n      try {\n        const response = await this.$axios.get(\"/data/documents.xml\", {\n          responseType: \"text\"\n        });\n        const parser = new XMLParser({\n          ignoreAttributes: false\n        });\n        const result = parser.parse(response.data);\n        if (result.documents && result.documents.document) {\n          const docs = Array.isArray(result.documents.document) ? result.documents.document : [result.documents.document];\n          this.documents = docs.map(doc => ({\n            title: doc.title || \"\",\n            author: doc.author || \"\"\n          }));\n        } else {\n          console.error(\"Invalid XML structure or no elements found.\");\n        }\n      } catch (error) {\n        console.error(\"Error fetching XML:\", error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    toggleSort(columnKey) {\n      if (this.sortBy[0]?.key === columnKey) {\n        this.sortBy[0].order = this.sortBy[0].order === \"asc\" ? \"desc\" : \"asc\";\n      } else {\n        this.sortBy = [{\n          key: columnKey,\n          order: \"asc\"\n        }];\n      }\n    },\n    sortFunction(a, b) {\n      if (!this.sortBy.length) return 0;\n      const {\n        key,\n        order\n      } = this.sortBy[0];\n      const valueA = a[key]?.toLowerCase() || \"\";\n      const valueB = b[key]?.toLowerCase() || \"\";\n      return order === \"asc\" ? valueA.localeCompare(valueB) : valueB.localeCompare(valueA);\n    }\n  }\n};","map":{"version":3,"names":["XMLParser","data","rawHeaders","title","key","sortable","documents","loading","search","sortBy","order","itemsPerPage","computed","computedHeaders","filteredDocuments","filter","doc","toLowerCase","includes","author","sort","a","b","sortFunction","mounted","fetchDocuments","methods","response","$axios","get","responseType","parser","ignoreAttributes","result","parse","document","docs","Array","isArray","map","console","error","toggleSort","columnKey","length","valueA","valueB","localeCompare"],"sources":["/Volumes/Java/Work/workspaces/WebApp/first-vue-project/src/views/DocumentView.vue"],"sourcesContent":["<template>\n  <div class=\"document-container\">\n    <h1>Documents</h1>\n\n    <!-- Search and Filter -->\n    <v-row class=\"mb-4\">\n      <v-col cols=\"12\" md=\"6\">\n        <v-text-field\n          v-model=\"search\"\n          label=\"Search documents...\"\n          variant=\"outlined\"\n          clearable\n          prepend-inner-icon=\"mdi-magnify\"\n        ></v-text-field>\n      </v-col>\n    </v-row>\n\n    <!-- Data Table -->\n    <v-progress-circular\n      v-if=\"loading\"\n      indeterminate\n      color=\"primary\"\n    ></v-progress-circular>\n\n    <v-data-table\n      v-if=\"!loading && documents.length > 0\"\n      :headers=\"computedHeaders\"\n      :items=\"filteredDocuments\"\n      v-model:sort-by=\"sortBy\"\n      :items-per-page=\"itemsPerPage\"\n      class=\"elevation-2 bordered\"\n    >\n      <!-- Corrected Slots for Sorting -->\n      <template #column=\"{ column }\">\n        <v-btn variant=\"text\" @click=\"toggleSort(column.key)\">\n          {{ column.title }}\n          <v-icon v-if=\"sortBy[0]?.key === column.key\">\n            {{ sortBy[0]?.order === \"asc\" ? \"mdi-arrow-up\" : \"mdi-arrow-down\" }}\n          </v-icon>\n        </v-btn>\n      </template>\n    </v-data-table>\n\n    <div v-if=\"!loading && documents.length === 0\">No documents found.</div>\n  </div>\n</template>\n\n<script>\nimport { XMLParser } from \"fast-xml-parser\";\n\nexport default {\n  data() {\n    return {\n      rawHeaders: [\n        { title: \"Title\", key: \"title\", sortable: true },\n        { title: \"Author\", key: \"author\", sortable: true },\n      ],\n      documents: [],\n      loading: true,\n      search: \"\",\n      sortBy: [{ key: \"title\", order: \"asc\" }], // Default sorting\n      itemsPerPage: 10,\n    };\n  },\n  computed: {\n    computedHeaders() {\n      return this.rawHeaders;\n    },\n    filteredDocuments() {\n      return this.documents\n        .filter(\n          (doc) =>\n            doc.title.toLowerCase().includes(this.search.toLowerCase()) ||\n            doc.author.toLowerCase().includes(this.search.toLowerCase())\n        )\n        .sort((a, b) => this.sortFunction(a, b));\n    },\n  },\n  mounted() {\n    this.fetchDocuments();\n  },\n  methods: {\n    async fetchDocuments() {\n      try {\n        const response = await this.$axios.get(\"/data/documents.xml\", {\n          responseType: \"text\",\n        });\n\n        const parser = new XMLParser({ ignoreAttributes: false });\n        const result = parser.parse(response.data);\n\n        if (result.documents && result.documents.document) {\n          const docs = Array.isArray(result.documents.document)\n            ? result.documents.document\n            : [result.documents.document];\n\n          this.documents = docs.map((doc) => ({\n            title: doc.title || \"\",\n            author: doc.author || \"\",\n          }));\n        } else {\n          console.error(\"Invalid XML structure or no elements found.\");\n        }\n      } catch (error) {\n        console.error(\"Error fetching XML:\", error);\n      } finally {\n        this.loading = false;\n      }\n    },\n    toggleSort(columnKey) {\n      if (this.sortBy[0]?.key === columnKey) {\n        this.sortBy[0].order = this.sortBy[0].order === \"asc\" ? \"desc\" : \"asc\";\n      } else {\n        this.sortBy = [{ key: columnKey, order: \"asc\" }];\n      }\n    },\n    sortFunction(a, b) {\n      if (!this.sortBy.length) return 0;\n\n      const { key, order } = this.sortBy[0];\n      const valueA = a[key]?.toLowerCase() || \"\";\n      const valueB = b[key]?.toLowerCase() || \"\";\n\n      return order === \"asc\"\n        ? valueA.localeCompare(valueB)\n        : valueB.localeCompare(valueA);\n    },\n  },\n};\n</script>\n\n<style scoped>\n.document-container {\n  max-width: 900px;\n  margin: auto;\n  padding: 20px;\n}\n\n.bordered {\n  border: 1px solid #ccc;\n  border-radius: 8px;\n}\n\n.v-data-table :deep(.v-data-table__wrapper > table > tbody > tr > td) {\n  padding: 10px;\n}\n\n.v-text-field {\n  max-width: 100%;\n}\n</style>\n"],"mappings":";;;AAgDA,SAASA,SAAQ,QAAS,iBAAiB;AAE3C,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,UAAU,EAAE,CACV;QAAEC,KAAK,EAAE,OAAO;QAAEC,GAAG,EAAE,OAAO;QAAEC,QAAQ,EAAE;MAAK,CAAC,EAChD;QAAEF,KAAK,EAAE,QAAQ;QAAEC,GAAG,EAAE,QAAQ;QAAEC,QAAQ,EAAE;MAAK,CAAC,CACnD;MACDC,SAAS,EAAE,EAAE;MACbC,OAAO,EAAE,IAAI;MACbC,MAAM,EAAE,EAAE;MACVC,MAAM,EAAE,CAAC;QAAEL,GAAG,EAAE,OAAO;QAAEM,KAAK,EAAE;MAAM,CAAC,CAAC;MAAE;MAC1CC,YAAY,EAAE;IAChB,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,eAAeA,CAAA,EAAG;MAChB,OAAO,IAAI,CAACX,UAAU;IACxB,CAAC;IACDY,iBAAiBA,CAAA,EAAG;MAClB,OAAO,IAAI,CAACR,SAAQ,CACjBS,MAAM,CACJC,GAAG,IACFA,GAAG,CAACb,KAAK,CAACc,WAAW,CAAC,CAAC,CAACC,QAAQ,CAAC,IAAI,CAACV,MAAM,CAACS,